# Perl exec signatures
exec([[:space:]]*\(|[[:space:]]+).*\$.*\)?
fork([[:space:]]*\(|[[:space:]]+).*\)?
`.*\$.*`
system([[:space:]]*\(?|[[:space:]]+)*\$.*\)?
open([[:space:]]*\(?|[[:space:]]+)*\$.*\)?
# Perl-fruit signatures
exec[[:space:]]*\(?.*\$ARGV.*\)?
exec[[:space:]]*\(?.*\$.*->param[[:space:]]*\(.*\).*\)?
system[[:space:]]*\(?.*\$ARGV.*\)?
system[[:space:]]*\(?.*\$.*->param[[:space:]]*\(.*\).*\)?
`.*\$ARGV.*`
`.*\$.*->param[[:space:]]*\(.*\).*`
eval[[:space:]]*\(?.*\$ARGV.*\)?
eval[[:space:]]*\(?.*\$.*->param[[:space:]]*\(.*\).*\)?
use[[:space:]]+.*\$ARGV.*
use[[:space:]]+.*\$.*->param[[:space:]]*\(.*\).*
(WHERE|where)[[:space:]]+.*=.*\$.*->param[[:space:]]*\(.*\)
(LIKE|like)[[:space:]]+.*\$.*->param[[:space:]]*\(.*\)
(ORDER BY|order by)[[:space:]]+.*\$.*->param[[:space:]]*\(.*\)
(LIMIT|limit)[[:space:]]+.*\$.*->param[[:space:]]*\(.*\)
# Perl superglobal signatures
\$ARGV\[[^\]]+\]
\$ARGC
\$ENV
# Perl signatures
getc
readdir([[:space:]]+|[[:space:]]*\().*\$.*
read([[:space:]]+|[[:space:]]*\().*\$.*
sysread
eval.*\$.*
fctnl
ioctl
bind
setpgrp
syscall
connect.*\$.*
glob([[:space:]]+|[[:space:]]*\().*\$.*
mkdir([[:space:]]+|[[:space:]]*\().*\$.*
rmdir([[:space:]]+|[[:space:]]*\().*\$.*
link([[:space:]]+|[[:space:]]*\().*\$.*
unlink([[:space:]]+|[[:space:]]*\().*\$.*
chmod([[:space:]]+|[[:space:]]*\().*\$.*
chown([[:space:]]+|[[:space:]]*\().*\$.*
chroot
symlink
truncate([[:space:]]+|[[:space:]]*\().*\$.*
kill.*\$.*
umask
->param[[:space:]]*\(.*\)
# Perl xss signatures
print[[:space:]]*.*\$.*->param\(?.*\)?
